{
  "name": "trpl/trpl_wallet",
  "description": "Apple Wallet and Google Wallet passes for ACME Ticketing orders and memberships.",
  "type": "drupal-custom-module",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Drupal\\trpl_wallet\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Drupal\\Tests\\trpl_wallet\\Unit\\": "tests/src/Unit/" }
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
